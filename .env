# ======================
# OLLAMA
# ======================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3-local

# ======================
# EMBEDDINGS
# ======================
EMBEDDING_MODEL=nomic-embed-text

# ======================
# DATABASE
# ======================
DATABASE_URL=sqlite:///assembly.db

# ======================
# CHROMADB
# ======================
CHROMA_PATH=chromadb

# ======================
# FILE UPLOADS
# ======================
UPLOAD_FOLDER=uploads

# ======================
# LOGGING
# ======================
LOG_LEVEL=INFO
DEBUG=True